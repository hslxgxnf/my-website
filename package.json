    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-syntax-highlighter": "16.1.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.9",
    "sass": "1.105.0",
    "stylelint": "17.15.0",
    "stylelint-order": "8.1.1",
